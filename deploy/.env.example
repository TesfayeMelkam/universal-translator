# Copy to deploy/.env and fill in. Never commit .env.
DOMAIN=call.example.com          # a domain/subdomain whose DNS "A" record points to this server
ACCESS_CODE=change-me-please     # whoever starts calls / translates must know this
TURN_SECRET=                     # generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TRANSLATION_PROVIDER=mock        # mock | nllb (nllb needs the model inside the container, see README)
MAX_PARTICIPANTS=4

# --- optional: large calls (docker-compose.livekit.yml) ---
# LIVEKIT_DOMAIN=live.example.com
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=              # generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MAX_LARGE_PARTICIPANTS=12
# --- optional: Telegram bot ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# --- optional: accounts ---
# AUTH_MODE=required               # off | optional | required
