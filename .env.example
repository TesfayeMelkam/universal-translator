# Copy to .env (the setup script does this). Never commit .env. Restart run.py after changing it.
# Lines starting with # are comments. Text after "  #" on a value line is also ignored.

# ---------------------------------------------------------------- TRANSLATION
# auto = use every online engine configured below, then the free MyMemory (works with NO key, needs internet).
# Other values:  mock (demo, a few greetings only) | nllb (offline model, big download) | a list such as  google,azure,mymemory,nllb
TRANSLATION_PROVIDER=auto

# Best quality for Amharic / Afaan Oromo / Tigrinya / Somali: Google Cloud Translation (Basic v2 API key).
# Restrict the key to the Cloud Translation API in Google Cloud Console.
GOOGLE_TRANSLATE_API_KEY=

# Microsoft Translator (Azure). Region is e.g. westeurope, eastus, global.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# LibreTranslate: self-hosted (private) or a hosted one with a key.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# MyMemory (free): an email address raises the free daily quota.
MYMEMORY_EMAIL=

CLOUD_TIMEOUT=15          # seconds to wait for an online engine
CLOUD_RETRIES=1           # extra tries on temporary errors (0-3)
CACHE_SIZE=2000           # recent translations kept in memory (0 = off); never written to disk

# PRIVACY: online engines receive the text you translate. For private text use the phrasebook or nllb.

# ---------------------------------------------------------------- YOUR OWN DATA (phrasebook)
# Files: every .csv/.json in data/glossary/ is loaded at start (file names starting with _ are ignored).
GLOSSARY_DIR=data/glossary
# Cloud: links that return CSV or JSON, comma separated. Examples:
#   Google Sheets -> File > Share > Publish to web > CSV     https://docs.google.com/spreadsheets/d/e/.../pub?output=csv
#   GitHub raw, S3 / Azure Blob / Google Cloud Storage links (a pre-signed URL works for private data)
DATA_SOURCE_URLS=
DATA_SYNC_MINUTES=0       # 0 = only at start and on the Sync button; e.g. 30 = refresh every 30 minutes

# ---------------------------------------------------------------- NETWORK / OTHER DEVICES
LAN_MODE=1                # 1 = phones/PCs on your Wi-Fi can open the app
# APP_HOST=0.0.0.0        # or choose the address yourself
# APP_PORT=8000
TRUST_PROXY=0             # 1 if the app is behind nginx/Caddy/a tunnel (uses X-Forwarded-For for the rate limit)

# ---------------------------------------------------------------- OTHER
TTS_PROVIDER=none         # none | pyttsx3   (browser voices are used by default)
MAX_CHARS=2000
RATE_LIMIT_PER_MINUTE=120
